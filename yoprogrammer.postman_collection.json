{
  "info": {
    "name": "YoProgrammer API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://<api-id>.execute-api.ap-south-1.amazonaws.com/dev",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\"status\":\"ok\"}"
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signup"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password1\",\n  \"name\": \"Test User\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": [
            {
              "name": "200 Success",
              "status": "OK",
              "code": 200,
              "body": "{\"message\":\"Sign up successful. Check your email for a verification code.\"}"
            },
            {
              "name": "409 User Exists",
              "status": "Conflict",
              "code": 409,
              "body": "{\"message\":\"An account with this email already exists.\"}"
            },
            {
              "name": "400 Bad Request",
              "status": "Bad Request",
              "code": 400,
              "body": "{\"message\":\"Invalid email address\"}"
            }
          ]
        },
        {
          "name": "Confirm Sign Up",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/auth/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "confirm"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"code\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": [
            {
              "name": "200 Success",
              "status": "OK",
              "code": 200,
              "body": "{\"message\":\"Email confirmed. You can now sign in.\"}"
            },
            {
              "name": "400 Invalid Code",
              "status": "Bad Request",
              "code": 400,
              "body": "{\"message\":\"Invalid verification code.\"}"
            },
            {
              "name": "400 Expired Code",
              "status": "Bad Request",
              "code": 400,
              "body": "{\"message\":\"Verification code has expired. Please request a new one.\"}"
            }
          ]
        },
        {
          "name": "Sign In",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', json.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/auth/signin",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signin"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password1\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": [
            {
              "name": "200 Success",
              "status": "OK",
              "code": 200,
              "body": "{\"idToken\":\"eyJ...\",\"accessToken\":\"eyJ...\",\"refreshToken\":\"eyJ...\",\"expiresIn\":3600}"
            },
            {
              "name": "401 Wrong Credentials",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\"message\":\"Incorrect email or password.\"}"
            },
            {
              "name": "403 Not Confirmed",
              "status": "Forbidden",
              "code": 403,
              "body": "{\"message\":\"Email not confirmed. Please verify your account first.\"}"
            }
          ]
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "forgot-password"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": [
            {
              "name": "200 Success",
              "status": "OK",
              "code": 200,
              "body": "{\"message\":\"Password reset code sent to your email.\"}"
            }
          ]
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "reset-password"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"code\": \"123456\",\n  \"newPassword\": \"NewPassword1\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": [
            {
              "name": "200 Success",
              "status": "OK",
              "code": 200,
              "body": "{\"message\":\"Password reset successful. You can now sign in.\"}"
            },
            {
              "name": "400 Invalid Code",
              "status": "Bad Request",
              "code": 400,
              "body": "{\"message\":\"Invalid reset code.\"}"
            },
            {
              "name": "400 Expired Code",
              "status": "Bad Request",
              "code": 400,
              "body": "{\"message\":\"Reset code has expired. Please request a new one.\"}"
            }
          ]
        }
      ]
    }
  ]
}
